* {
  box-sizing: border-box;
}

:root {
  --bg: #07111f;
  --bg-soft: #0d1b2a;
  --panel: #101f2d;
  --card: #132436;
  --text: #e6eefc;
  --muted: #9ab0c9;
  --line: rgba(143, 174, 214, 0.2);
  --primary: #65d5ff;
  --primary-strong: #2ea5ff;
  --accent: #6ef0c4;
  --danger: #ff6a73;
  --shadow: rgba(0, 0, 0, 0.28);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #08121d 0%, #0d1a2a 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(10px);
  background: rgba(8, 18, 29, 0.8);
  border-bottom: 1px solid var(--line);
}

.nav-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78px;
  gap: 24px;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.brand-mark {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #02131c;
  border-radius: 10px;
  font-weight: 800;
}

.nav {
  display: flex;
  gap: 24px;
  color: var(--muted);
  font-size: 0.95rem;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

select,
input,
textarea {
  width: 100%;
  border: 1px solid var(--line);
  background: rgba(10, 18, 28, 0.9);
  border-radius: 12px;
  color: var(--text);
  padding: 0.9rem 1rem;
}

textarea {
  resize: vertical;
}

.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 12px;
  padding: 0.9rem 1.25rem;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: #06151d;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  color: var(--text);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
}

.large {
  padding: 1rem 1.5rem;
}

.hero {
  padding: 90px 0 48px;
}

.hero-grid,
.showcase-grid,
.contact-grid,
.auth-panel,
.two-column {
  display: grid;
  gap: 32px;
}

.hero-grid,
.showcase-grid,
.contact-grid {
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
}

.eyebrow {
  display: inline-block;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--accent);
  font-weight: 700;
  font-size: 0.7rem;
  margin-bottom: 12px;
}

h1,
h2,
h3,
h4,
p {
  margin-top: 0;
}

h1 {
  font-size: clamp(2.7rem, 5vw, 4.5rem);
  line-height: 1.05;
  margin-bottom: 18px;
}

.lead {
  color: var(--muted);
  line-height: 1.7;
  max-width: 640px;
  margin-bottom: 24px;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 28px;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
}

.hero-metrics div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: var(--muted);
}

.hero-metrics strong {
  font-size: 1.8rem;
  color: var(--text);
}

.hero-panel {
  background: linear-gradient(180deg, rgba(19, 36, 54, 0.95), rgba(8, 18, 29, 0.95));
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 20px 50px var(--shadow);
}

.mini-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 20px;
}

.mini-card h3 {
  margin: 10px 0 18px;
}

.muted {
  color: var(--muted);
}

.status-pill {
  display: inline-block;
  padding: 0.35rem 0.7rem;
  background: rgba(110, 240, 196, 0.15);
  color: var(--accent);
  border-radius: 999px;
  font-size: 0.8rem;
}

.mini-stack {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.mini-box {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
}

.mini-label {
  display: block;
  color: var(--muted);
  font-size: 0.8rem;
  margin-bottom: 8px;
}

.features,
.pricing,
.faq,
.contact {
  padding: 68px 0;
}

.cards-row,
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  margin-top: 28px;
}

.feature-card,
.price-card,
.panel-card,
.auth-card,
.faq-item {
  background: rgba(18, 31, 46, 0.9);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
}

.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(101, 213, 255, 0.1);
  color: var(--primary);
  font-weight: 700;
}

.feature-card p,
.price-card p,
.faq-item p,
.legal-page p,
li {
  color: var(--muted);
  line-height: 1.7;
}

.showcase-grid {
  align-items: center;
}

.checklist {
  padding-left: 20px;
  color: var(--muted);
  line-height: 1.9;
}

.terminal {
  background: #09141f;
  border: 1px solid var(--line);
  border-radius: 20px;
  overflow: hidden;
}

.terminal-header {
  display: flex;
  gap: 10px;
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid var(--line);
}

.terminal-header span {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: inline-block;
  background: rgba(255, 255, 255, 0.4);
}

.terminal pre {
  margin: 0;
  padding: 22px 16px 26px;
  color: var(--accent);
  line-height: 1.8;
  white-space: pre-wrap;
}

.section-copy {
  color: var(--muted);
  max-width: 620px;
  margin-top: 12px;
}

.pricing-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.plan-name {
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.75rem;
  color: var(--accent);
}

.price-card h3 {
  font-size: 2.2rem;
  margin: 12px 0;
}

.price-card h3 span {
  font-size: 1rem;
  color: var(--muted);
}

.full {
  width: 100%;
}

.faq-list {
  display: grid;
  gap: 18px;
  margin-top: 24px;
}

.contact-grid {
  grid-template-columns: 0.8fr 1.2fr;
}

.card-form {
  display: grid;
  gap: 12px;
}

.auth-shell,
.app-shell,
.legal-page {
  padding: 52px 0 80px;
}

.auth-panel {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.auth-card form {
  display: grid;
  gap: 12px;
}

.welcome-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.tenant-select-wrap {
  min-width: 220px;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}

.metric-card {
  background: rgba(18, 31, 46, 0.9);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.metric-card span {
  color: var(--muted);
}

.metric-card strong {
  font-size: 2rem;
}

.two-column {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 24px 0;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  text-align: left;
  padding: 12px 10px;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
}

th {
  color: var(--text);
}

.audit-list {
  display: grid;
  gap: 10px;
  padding-left: 18px;
}

.audit-list li {
  color: var(--muted);
}

.legal-page ol {
  padding-left: 18px;
  color: var(--muted);
}

@media (max-width: 860px) {
  .hero-grid,
  .showcase-grid,
  .contact-grid,
  .auth-panel,
  .two-column,
  .pricing-grid,
  .cards-row,
  .metric-grid {
    grid-template-columns: 1fr;
  }

  .nav {
    display: none;
  }

  .nav-shell {
    flex-wrap: wrap;
    padding: 12px 0;
  }

  .welcome-row {
    flex-direction: column;
    align-items: flex-start;
  }
}
